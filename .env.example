# Copy to .env beside compose.yaml. Keep .env private; it is ignored by Git.

# Use latest until the numbered release image has successfully published.
# Then pin a release, for example ghcr.io/karlocizma/embergate:v0.7.2.
EMBERGATE_IMAGE=ghcr.io/karlocizma/embergate:latest

# Optional recovery override. Leave blank to use browser-based first-run setup
# and manage the admin password in the dashboard.
GATEWAY_ADMIN_PASSWORD=

# Optional integrations. These can also be configured in the dashboard.
GATEWAY_ALERT_WEBHOOK_URL=
GATEWAY_CLOUDFLARE_API_TOKEN=
